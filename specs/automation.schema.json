{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zeno/automation.schema.json",
  "title": "Zeno automation design contract (planning draft v1)",
  "description": "Illustrative schema; Claude should version/migrate as implementation develops. Importing does not execute or authorize.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "origin",
    "enabled",
    "trigger",
    "steps",
    "executionPolicy",
    "approval"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "origin": {
      "enum": [
        "manual",
        "learned"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "timezone",
            "at",
            "days"
          ],
          "properties": {
            "type": {
              "const": "weekly_time"
            },
            "timezone": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "days": {
              "type": "array",
              "items": {
                "enum": [
                  "MO",
                  "TU",
                  "WE",
                  "TH",
                  "FR",
                  "SA",
                  "SU"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "at",
            "timezone"
          ],
          "properties": {
            "type": {
              "const": "once"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "timezone": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "minutes"
          ],
          "properties": {
            "type": {
              "const": "interval"
            },
            "minutes": {
              "type": "integer",
              "minimum": 15
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "threshold"
          ],
          "properties": {
            "type": {
              "const": "battery_below"
            },
            "threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "event"
          ],
          "properties": {
            "type": {
              "const": "device_event"
            },
            "event": {
              "enum": [
                "charging_connected",
                "charging_disconnected",
                "first_unlock",
                "headset_connected"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "package"
          ],
          "properties": {
            "type": {
              "const": "app_opened"
            },
            "package": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "conditions": {
      "type": "object",
      "required": [
        "op",
        "clauses"
      ],
      "properties": {
        "op": {
          "enum": [
            "all",
            "any"
          ]
        },
        "clauses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "comparator",
              "value"
            ],
            "properties": {
              "field": {
                "enum": [
                  "battery_percent",
                  "charging",
                  "screen_unlocked",
                  "weekday"
                ]
              },
              "comparator": {
                "enum": [
                  "eq",
                  "lt",
                  "gt",
                  "in"
                ]
              },
              "value": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "parameters"
        ],
        "properties": {
          "type": {
            "enum": [
              "send_sms",
              "open_app",
              "set_dnd",
              "set_brightness",
              "lock_screen",
              "set_volume",
              "notify",
              "speak",
              "set_flashlight",
              "play_media"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "onFailure": {
            "enum": [
              "stop",
              "continue"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "executionPolicy": {
      "type": "object",
      "required": [
        "requiresConfirmationAtRun",
        "missedRun",
        "maxRetries",
        "notifyOnFailure"
      ],
      "properties": {
        "requiresConfirmationAtRun": {
          "type": "boolean"
        },
        "missedRun": {
          "enum": [
            "skip",
            "run_if_within_grace"
          ]
        },
        "graceMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "notifyOnFailure": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": [
        "status",
        "approvedVersion"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "approved",
            "revoked"
          ]
        },
        "approvedVersion": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reviewRequired": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
